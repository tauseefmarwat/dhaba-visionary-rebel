{
  "name": "visionary-rebels/dhaba-stats-api",
  "type": "project",
  "description": "Dhaba Orders live statistics API",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
